APP_NAME="Bibliotheque Numerique Mahajanga"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tahiry_data
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=/api

# --- Intégration RAG / Gemini ---
# Clé API Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Texte : alias "latest" pour suivre automatiquement la dernière version stable.
GEMINI_MODEL=gemini-flash-latest
# Modèle rapide (questions simples, coût et latence réduits).
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Réflexion des assistants de gestion : low|medium|high (vide = défaut du modèle).
GEMINI_THINKING_LEVEL=low
# Chaîne de repli automatique (503 / 429 / 404). Du plus capable au plus léger.
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite

# Génération d'images (Nano Banana 2 → Nano Banana 2 Lite).
# Déclenchée dans l'assistant document par une demande explicite ("génère/dessine une image/schéma").
# Quota gratuit : ~500 images/jour, ~10/min, 1024x1024.
GEMINI_IMAGE_MODELS=gemini-3.1-flash-image,gemini-3.1-flash-lite-image

GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Couvertures générées par IA (Pollinations, couverture de secours dessinée si échec) ---
# Jeton facultatif (gratuit, https://enter.pollinations.ai) : plus fiable, sans filigrane.
POLLINATIONS_TOKEN=

# SMS « compte activé » : log (écrit dans storage/logs) | mapi (envoi réel) | off
SMS_DRIVER=log
MAPI_API_URL=https://messaging.mapi.mg/api
MAPI_USERNAME=
MAPI_PASSWORD=
